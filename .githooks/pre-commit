#!/usr/bin/env bash
# Pre-commit gate: run the fast host-side `just precommit` workflow. The Rust
# command owns Git/index reconciliation, preserving staged subsets while
# auto-staging only formatter/check mutations that are provably safe.
#
# SKIP_PRE_COMMIT=1 bypasses for WIP commits.
set -euo pipefail

if [ "${SKIP_PRE_COMMIT:-0}" = "1" ]; then
    echo "--- pre-commit: SKIP_PRE_COMMIT=1, skipping ---"
    exit 0
fi

echo "--- pre-commit: running just precommit ---"
exec just precommit
